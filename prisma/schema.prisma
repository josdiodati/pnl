generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & multi-company ----------

model Usuario {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String
  nombre               String
  empresas             UsuarioEmpresa[]
  movimientosCreados   Movimiento[]     @relation("creadoPor")
  movimientosValidados Movimiento[]     @relation("validadoPor")
  lotesIngesta         LoteIngesta[]
  createdAt            DateTime         @default(now())
}

model Empresa {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique // used in URL, inbound email and telegram linking
  razonSocial            String
  cuit                   String
  inicioEjercicioFiscal  Int                     @default(7) // month 1-12, default July
  logoKey                String?
  telegramCodigoVinculo  String?                 @unique // one-time-ish linking code shown in config screen
  usuarios               UsuarioEmpresa[]
  invitaciones           Invitacion[]
  categorias             Categoria[]
  centrosCosto           CentroCosto[]
  clientes               Cliente[]
  proyectos              Proyecto[]
  contrapartes           Contraparte[]
  plantillasDistribucion PlantillaDistribucion[]
  plantillasRecurrentes  PlantillaRecurrente[]
  reglasAsignacion       ReglaAsignacion[]
  movimientos            Movimiento[]
  lotesIngesta           LoteIngesta[]
  periodos               Periodo[]
  auditLogs              AuditLog[]
  telegramVinculos       TelegramVinculo[]
  empleados              Empleado[]
  recibosSueldo          ReciboSueldo[]
  resumenes              Resumen[]
  reglasResumen          ReglaResumen[]
  createdAt              DateTime                @default(now())
}

enum Rol {
  CARGADOR
  VALIDADOR
  ADMINISTRADOR
}

model UsuarioEmpresa {
  id        String  @id @default(cuid())
  usuarioId String
  empresaId String
  rol       Rol
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([usuarioId, empresaId])
}

model Invitacion {
  id        String   @id @default(cuid())
  empresaId String
  email     String
  rol       Rol
  token     String   @unique
  aceptada  Boolean  @default(false)
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())
}

// ---------- Masters (all scoped by empresa) ----------

enum TipoCategoria {
  INGRESO
  EGRESO
}

model Categoria {
  id              String        @id @default(cuid())
  empresaId       String
  nombre          String
  tipo            TipoCategoria
  padreId         String? // hierarchy, max 2 levels
  activa          Boolean       @default(true)
  // Sus movimientos computan dentro del bloque "Costos de personal" del libro
  // (ej. Prepagas) y salen del resumen general — sin doble conteo.
  esCostoPersonal Boolean       @default(false)
  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  padre           Categoria?    @relation("jerarquia", fields: [padreId], references: [id])
  hijas           Categoria[]   @relation("jerarquia")
  movimientos     Movimiento[]

  @@unique([empresaId, nombre])
}

enum TipoCentroCosto {
  NEGOCIO
  SOPORTE
}

model CentroCosto {
  id              String                       @id @default(cuid())
  empresaId       String
  nombre          String
  tipo            TipoCentroCosto
  activo          Boolean                      @default(true)
  clientesHijos   Cliente[]                    @relation("clientesDelCentro")
  empresa         Empresa                      @relation(fields: [empresaId], references: [id])
  lineas          MovimientoLinea[]
  plantillaLineas PlantillaDistribucionLinea[]
  empleadoLineas  EmpleadoDistribucionLinea[]  @relation("empleadoLineas")
  reciboLineas    ReciboDistribucionLinea[]    @relation("reciboLineas")

  @@unique([empresaId, nombre])
}

// Second analysis dimension (optional per line)
model Cliente {
  id              String                       @id @default(cuid())
  empresaId       String
  nombre          String
  codigo          String?
  activo          Boolean                      @default(true)
  // Árbol de asignación: un cliente clasificado sólo vale bajo su centro de
  // costo; sin clasificar (null) vale bajo cualquiera.
  centroCostoId   String?
  centroCosto     CentroCosto?                 @relation("clientesDelCentro", fields: [centroCostoId], references: [id])
  proyectosHijos  Proyecto[]                   @relation("proyectosDelCliente")
  empresa         Empresa                      @relation(fields: [empresaId], references: [id])
  lineas          MovimientoLinea[]
  plantillaLineas PlantillaDistribucionLinea[]
  empleadoLineas  EmpleadoDistribucionLinea[]  @relation("empleadoLineas")
  reciboLineas    ReciboDistribucionLinea[]    @relation("reciboLineas")

  @@unique([empresaId, nombre])
}

// Third analysis dimension (optional per line)
model Proyecto {
  id              String                       @id @default(cuid())
  empresaId       String
  nombre          String
  codigo          String?
  activo          Boolean                      @default(true)
  // Árbol de asignación: un proyecto clasificado sólo vale bajo su cliente.
  clienteId       String?
  cliente         Cliente?                     @relation("proyectosDelCliente", fields: [clienteId], references: [id])
  empresa         Empresa                      @relation(fields: [empresaId], references: [id])
  lineas          MovimientoLinea[]
  plantillaLineas PlantillaDistribucionLinea[]
  empleadoLineas  EmpleadoDistribucionLinea[]  @relation("empleadoLineas")
  reciboLineas    ReciboDistribucionLinea[]    @relation("reciboLineas")

  @@unique([empresaId, nombre])
}

enum TipoContraparte {
  PROVEEDOR
  CLIENTE
  AMBOS
}

model Contraparte {
  id                      String          @id @default(cuid())
  empresaId               String
  cuit                    String
  razonSocial             String
  tipo                    TipoContraparte
  condicionIva            String?
  categoriaDefaultId      String?
  distribucionDefaultId   String? // default distribution template
  instruccionesExtraccion String? // recurring corrections, injected into the LLM prompt
  descriptoresResumen     Json? // lista de strings normalizados
  activa                  Boolean         @default(true)
  empresa                 Empresa         @relation(fields: [empresaId], references: [id])
  movimientos             Movimiento[]

  @@unique([empresaId, cuit])
}

// Reusable distribution template (e.g. "Alquiler 60/30/10")
model PlantillaDistribucion {
  id        String                       @id @default(cuid())
  empresaId String
  nombre    String
  empresa   Empresa                      @relation(fields: [empresaId], references: [id])
  lineas    PlantillaDistribucionLinea[]

  @@unique([empresaId, nombre])
}

model PlantillaDistribucionLinea {
  id            String                @id @default(cuid())
  plantillaId   String
  centroCostoId String
  clienteId     String?
  proyectoId    String?
  porcentaje    Decimal               @db.Decimal(7, 4) // lines must sum 100
  plantilla     PlantillaDistribucion @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto           @relation(fields: [centroCostoId], references: [id])
  cliente       Cliente?              @relation(fields: [clienteId], references: [id])
  proyecto      Proyecto?             @relation(fields: [proyectoId], references: [id])
}

// Recurring template (repeated monthly entry: legal fees, salaries, ...)
model PlantillaRecurrente {
  id                     String  @id @default(cuid())
  empresaId              String
  nombre                 String
  categoriaId            String
  importeSugerido        Decimal @db.Decimal(18, 2)
  descripcion            String?
  diaDelMes              Int     @default(1)
  distribucionId         String? // associated distribution template
  // If true, "generate month" copies the amount validated for this template the previous month
  usarImporteMesAnterior Boolean @default(false)
  activa                 Boolean @default(true)
  empresa                Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
}

// Regla de preasignación: condiciones (AND) -> acción (categoría + distribución)
model ReglaAsignacion {
  id             String   @id @default(cuid())
  empresaId      String
  nombre         String
  prioridad      Int      @default(100) // menor = se evalúa primero
  activa         Boolean  @default(true)
  accion         String   @default("ASIGNAR") // ASIGNAR | OBSERVAR (descarta a Observado)
  cargadoPorId   String?
  cuit           String?
  canal          String?
  palabraClave   String?
  categoriaId    String?
  distribucionId String?
  centroCostoId  String?
  clienteId      String?
  proyectoId     String?
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId, nombre])
}

// ---------- Movements ----------

enum OrigenMovimiento {
  COMPROBANTE
  VENTA_COMPROBANTE
  ASIENTO_MANUAL
  VENTA_MANUAL
  RESUMEN
}

enum EstadoMovimiento {
  INGRESADO
  PROCESANDO
  PENDIENTE_VALIDACION
  RETENIDO
  OBSERVADO
  VALIDADO
  ASIGNADO
  ANULADO
  ERROR_PROCESAMIENTO
  DUPLICADO
}

enum Moneda {
  ARS
  USD
  EUR
  OTRA
}

model Movimiento {
  id                 String           @id @default(cuid())
  empresaId          String
  origen             OrigenMovimiento
  estado             EstadoMovimiento @default(INGRESADO)
  fechaDevengamiento DateTime? // accrual month (date of the voucher)
  categoriaId        String?
  contraparteId      String?
  descripcion        String?
  moneda             Moneda           @default(ARS)
  // Pesos por unidad de moneda extranjera. Obligatorio para validar/asignar
  // cuando moneda ≠ ARS; el QR de AFIP lo aporta solo (ctz) cuando existe.
  tipoCambio         Decimal?         @db.Decimal(12, 4)

  // Amounts (positive; accounting sign derives from categoria + tipoComprobante)
  netoGravado      Decimal? @db.Decimal(18, 2)
  iva21            Decimal? @db.Decimal(18, 2)
  iva105           Decimal? @db.Decimal(18, 2)
  iva27            Decimal? @db.Decimal(18, 2)
  percepcionesIva  Decimal? @db.Decimal(18, 2)
  percepcionesIibb Decimal? @db.Decimal(18, 2)
  otrosTributos    Decimal? @db.Decimal(18, 2)
  noGravadoExento  Decimal? @db.Decimal(18, 2)
  total            Decimal? @db.Decimal(18, 2)

  // Voucher data
  cuitEmisor      String? // extracted issuer CUIT, used for duplicate detection before matching
  tipoComprobante String?
  puntoVenta      String?
  numero          String?
  cae             String?
  vencimientoCae  DateTime?

  // OCR / file
  archivoKey    String?
  archivoNombre String?
  archivoMime   String?
  archivoHash   String?
  extraccionRaw Json? // raw JSON returned by the LLM
  camposRevisar Json? // which fields ended up flagged REVISAR
  confianza     Json? // per-field confidence when available

  // ARCA
  arcaEstado       String    @default("NO_VERIFICADO") // NO_VERIFICADO|VALIDO|INVALIDO|ERROR_CONSULTA
  arcaDetalle      String?
  arcaConsultadoAt DateTime?

  // Consumo de tokens del LLM por comprobante (monitoreo de costo vía DB; sin frontend)
  tokensEntrada       Int? // input_tokens
  tokensSalida        Int? // output_tokens
  tokensCacheCreacion Int? // cache_creation_input_tokens
  tokensCacheLectura  Int? // cache_read_input_tokens
  modeloExtractor     String? // modelo usado (p.ej. claude-opus-4-8); null en mock
  qrEstado            String? // QR AFIP/ARCA: OK | ILEGIBLE | SIN_QR | null (no aplica / imagen)

  // Assignment (double dimension, percentage split)
  lineas        MovimientoLinea[]
  lineasResumen ResumenLinea[]

  flags           Json? // future metadata (e.g. recurring template id, pending "I/O" flag)
  periodoId       String?
  creadoPorId     String
  validadoPorId   String?
  motivoAnulacion String?
  canalIngreso    String? // WEB | FOTO | EMAIL | TELEGRAM | MANUAL
  loteId          String? // lote de ingesta (un drop web / un mail / un mensaje)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  empresa           Empresa              @relation(fields: [empresaId], references: [id])
  categoria         Categoria?           @relation(fields: [categoriaId], references: [id])
  contraparte       Contraparte?         @relation(fields: [contraparteId], references: [id])
  periodo           Periodo?             @relation(fields: [periodoId], references: [id])
  creadoPor         Usuario              @relation("creadoPor", fields: [creadoPorId], references: [id])
  validadoPor       Usuario?             @relation("validadoPor", fields: [validadoPorId], references: [id])
  vinculosEmpleados MovimientoEmpleado[]
  lote              LoteIngesta?         @relation(fields: [loteId], references: [id])

  @@index([empresaId, estado])
  @@index([empresaId, fechaDevengamiento])
}

// Lote de ingesta: agrupa los movimientos de "una vez que se procesaron
// archivos" (un drop en la web, un mail con adjuntos, un mensaje de Telegram)
// para mostrar progreso y resultados en /carga. Sin contadores materializados:
// el resumen se deriva de los movimientos del lote (resumirLote).
model LoteIngesta {
  id            String       @id @default(cuid())
  empresaId     String
  canal         String // WEB | FOTO | EMAIL | TELEGRAM
  creadoPorId   String?
  origenDetalle String? // remitente del email / usuario de telegram
  archivos      Int          @default(0) // cantidad esperada de comprobantes
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  creadoPor     Usuario?     @relation(fields: [creadoPorId], references: [id])
  movimientos   Movimiento[]
  createdAt     DateTime     @default(now())

  @@index([empresaId, createdAt])
}

enum OrigenLinea {
  MANUAL
  PRORRATEO // reserved for the future automatic allocation engine
}

model MovimientoLinea {
  id            String      @id @default(cuid())
  movimientoId  String
  centroCostoId String
  clienteId     String? // second dimension, optional
  proyectoId    String? // third dimension, optional
  porcentaje    Decimal     @db.Decimal(7, 4) // sum per movement = 100.0000
  origen        OrigenLinea @default(MANUAL)
  movimiento    Movimiento  @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto @relation(fields: [centroCostoId], references: [id])
  cliente       Cliente?    @relation(fields: [clienteId], references: [id])
  proyecto      Proyecto?   @relation(fields: [proyectoId], references: [id])
}

// ---------- Periods ----------

enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

model Periodo {
  id                      String                @id @default(cuid())
  empresaId               String
  anio                    Int
  mes                     Int
  estado                  EstadoPeriodo         @default(ABIERTO)
  cerradoPorId            String?
  cerradoAt               DateTime?
  empresa                 Empresa               @relation(fields: [empresaId], references: [id])
  movimientos             Movimiento[]
  resumenes               Resumen[]
  recibosSueldo           ReciboSueldo[]
  costosManualesEmpleados CostoManualEmpleado[]
  prepagasEmpleados       PrepagaEmpleado[]

  @@unique([empresaId, anio, mes])
}

// ---------- Resúmenes de tarjeta y banco (Spec E) ----------

enum TipoResumen {
  TARJETA
  BANCO
}

enum EstadoResumen {
  PROCESANDO
  EXTRAIDO
  ERROR_PROCESAMIENTO
}

enum EstadoLineaResumen {
  PENDIENTE
  SUGERIDA
  CONCILIADA
  IMPUTADA
  IGNORADA
}

model Resumen {
  id             String        @id @default(cuid())
  empresaId      String
  tipo           TipoResumen
  emisor         String // "VISA Santander", "Cuenta Frances"
  periodoId      String
  fechaCierre    DateTime?
  totalDeclarado Decimal?      @db.Decimal(18, 2) // control de completitud
  estado         EstadoResumen @default(PROCESANDO)
  nota           String? // error de extracción u observaciones

  archivoKey    String
  archivoNombre String
  archivoMime   String
  archivoHash   String

  extraccionRaw       Json?
  tokensEntrada       Int?
  tokensSalida        Int?
  tokensCacheCreacion Int?
  tokensCacheLectura  Int?
  modeloExtractor     String?

  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  periodo   Periodo        @relation(fields: [periodoId], references: [id])
  lineas    ResumenLinea[]
  createdAt DateTime       @default(now())

  @@index([empresaId, createdAt])
}

model ResumenLinea {
  id             String             @id @default(cuid())
  resumenId      String
  orden          Int
  fecha          DateTime?
  descriptor     String // tal como viene en el resumen
  monto          Decimal?           @db.Decimal(18, 2) // FIRMADO en ARS; null = consumo USD sin pesificar
  moneda         Moneda             @default(ARS)
  montoOrigen    Decimal?           @db.Decimal(18, 2) // importe en moneda origen (TC implícito)
  cuotas         String? // "3/6"
  cuenta         String? // cuenta/tarjeta dentro del PDF (BBVA consolida varias)
  titular        String? // resúmenes de tarjeta agrupan por titular
  estado         EstadoLineaResumen @default(PENDIENTE)
  movimientoId   String? // conciliado (existente) o imputado (creado)
  candidatos     Json? // [{movimientoId, score, motivo, rechazado?}] del matching
  motivoIgnorada String?
  reglaAplicada  String? // nombre de la ReglaResumen que la resolvió automáticamente

  resumen    Resumen     @relation(fields: [resumenId], references: [id], onDelete: Cascade)
  movimiento Movimiento? @relation(fields: [movimientoId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([resumenId])
  @@index([movimientoId])
}

enum AccionReglaResumen {
  IGNORAR
  IMPUTAR
}

// Regla de auto-resolución de líneas de resumen: si el descriptor (normalizado)
// contiene la condición, la línea se ignora o se imputa automáticamente al
// extraer un resumen (o con el botón "Aplicar reglas"). IMPUTAR sólo aplica a
// líneas SIN sugerencia de conciliación (la sugerencia gana: evita duplicar).
model ReglaResumen {
  id                 String             @id @default(cuid())
  empresaId          String
  nombre             String
  activa             Boolean            @default(true)
  descriptorContiene String // condición: contenido en el descriptor, normalizado
  emisor             String? // limitar a un emisor de resumen (opcional)
  tipo               TipoResumen? // limitar a tarjeta/banco (opcional)
  accion             AccionReglaResumen
  motivoIgnorar      String? // para IGNORAR
  // Para IMPUTAR (sin FK, como ReglaAsignacion: se valida al guardar):
  categoriaId        String?
  distribucionId     String? // plantilla de distribución
  centroCostoId      String? // línea única 100%
  clienteId          String?
  proyectoId         String?
  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([empresaId, nombre])
}

// ---------- Empleados (Spec D: costos de personal) ----------

enum TipoRecibo {
  MENSUAL
  SAC
  VACACIONES
  LIQUIDACION_FINAL
  OTRO
}

enum EstadoRecibo {
  PENDIENTE_REVISION
  CONFIRMADO
  ANULADO
}

model Empleado {
  id             String                      @id @default(cuid())
  empresaId      String
  nombre         String
  cuil           String // 11 dígitos normalizados; clave de matching en la ingesta
  legajo         String?
  categoria      String?
  sector         String?
  fechaIngreso   DateTime?
  fechaEgreso    DateTime?
  activo         Boolean                     @default(true)
  empresa        Empresa                     @relation(fields: [empresaId], references: [id])
  distribucion   EmpleadoDistribucionLinea[]
  recibos        ReciboSueldo[]
  costosManuales CostoManualEmpleado[]
  prepagas       PrepagaEmpleado[]
  vinculos       MovimientoEmpleado[]
  createdAt      DateTime                    @default(now())

  @@unique([empresaId, cuil])
}

// Distribución por defecto de la ficha (se COPIA al recibo al confirmar).
model EmpleadoDistribucionLinea {
  id            String      @id @default(cuid())
  empleadoId    String
  centroCostoId String
  clienteId     String?
  proyectoId    String?
  porcentaje    Decimal     @db.Decimal(7, 4) // suman 100
  empleado      Empleado    @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto @relation("empleadoLineas", fields: [centroCostoId], references: [id])
  cliente       Cliente?    @relation("empleadoLineas", fields: [clienteId], references: [id])
  proyecto      Proyecto?   @relation("empleadoLineas", fields: [proyectoId], references: [id])
}

model ReciboSueldo {
  id         String       @id @default(cuid())
  empresaId  String
  empleadoId String
  periodoId  String
  tipo       TipoRecibo   @default(MENSUAL)
  estado     EstadoRecibo @default(PENDIENTE_REVISION)
  nota       String? // motivo de anulación (p.ej. duplicado) o advertencias de ingesta

  // Totales extraídos (positivos). costoTotalEmpleador es LA cifra que va al P&L.
  brutoRemunerativo       Decimal? @db.Decimal(18, 2)
  noRemunerativo          Decimal? @db.Decimal(18, 2)
  retenciones             Decimal? @db.Decimal(18, 2)
  sueldoNeto              Decimal? @db.Decimal(18, 2)
  contribucionesEmpleador Decimal? @db.Decimal(18, 2)
  costoTotalEmpleador     Decimal? @db.Decimal(18, 2)

  // Lista flexible de conceptos {concepto, unidad?, importe, naturaleza}:
  // otro modelo de recibo (otra empresa) no exige migración de schema.
  conceptos Json?

  // El PDF multi-recibo se guarda UNA vez; cada recibo apunta a su página.
  archivoKey    String?
  archivoNombre String?
  archivoMime   String?
  pagina        Int?

  extraccionRaw       Json?
  camposRevisar       Json?
  confianza           Json?
  tokensEntrada       Int?
  tokensSalida        Int?
  tokensCacheCreacion Int?
  tokensCacheLectura  Int?
  modeloExtractor     String?

  empresa      Empresa                   @relation(fields: [empresaId], references: [id])
  empleado     Empleado                  @relation(fields: [empleadoId], references: [id])
  periodo      Periodo                   @relation(fields: [periodoId], references: [id])
  lineas       ReciboDistribucionLinea[]
  createdAt    DateTime                  @default(now())
  confirmadoAt DateTime?

  // La guarda anti-duplicado (empleado, período, tipo) es de código, no @@unique:
  // el duplicado se conserva como fila ANULADO visible en la ficha.
  @@index([empresaId, empleadoId, periodoId])
}

// Distribución EFECTIVA del recibo: copia de la ficha al confirmar, editable
// sólo en ese recibo. Copia, no referencia: cambiar la ficha no reescribe historia.
model ReciboDistribucionLinea {
  id            String       @id @default(cuid())
  reciboId      String
  centroCostoId String
  clienteId     String?
  proyectoId    String?
  porcentaje    Decimal      @db.Decimal(7, 4)
  recibo        ReciboSueldo @relation(fields: [reciboId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto  @relation("reciboLineas", fields: [centroCostoId], references: [id])
  cliente       Cliente?     @relation("reciboLineas", fields: [clienteId], references: [id])
  proyecto      Proyecto?    @relation("reciboLineas", fields: [proyectoId], references: [id])
}

// Costo individual de seguimiento por empleado y período, cargado a mano en la
// ficha (ej. cuánto cuesta su plan de prepaga). NO impacta el P&L: el gasto
// real ya entra una sola vez por la factura agregada (categoría de personal).
model CostoManualEmpleado {
  id         String   @id @default(cuid())
  empleadoId String
  periodoId  String
  concepto   String
  monto      Decimal  @db.Decimal(18, 2)
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  periodo    Periodo  @relation(fields: [periodoId], references: [id])
  createdAt  DateTime @default(now())
}

// Prepaga asignada por empleado y período (vista de gestión, no contable):
// neto = costoPlan − fsrPct% × (aportes + contribuciones). Las vistas de
// empleados/proyectos computan max(0, neto); el libro sigue con las facturas.
model PrepagaEmpleado {
  id             String   @id @default(cuid())
  empleadoId     String
  periodoId      String
  prepaga        String // plan asignado (ej. "OSDE 210", "Swiss SMG02")
  costoPlan      Decimal  @db.Decimal(18, 2)
  aportes        Decimal  @default(0) @db.Decimal(18, 2)
  contribuciones Decimal  @default(0) @db.Decimal(18, 2)
  fsrPct         Decimal  @default(85) @db.Decimal(5, 2) // % que llega a la prepaga
  empleado       Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  periodo        Periodo  @relation(fields: [periodoId], references: [id])
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([empleadoId, periodoId])
}

// Vínculo comprobante→empleado (prepaga, etc.). Montos, no porcentajes: una
// factura única reparte importes distintos y el remanente sigue siendo gasto
// general. La porción vinculada sigue la distribución de la FICHA del empleado.
model MovimientoEmpleado {
  id           String     @id @default(cuid())
  movimientoId String
  empleadoId   String
  monto        Decimal    @db.Decimal(18, 2)
  movimiento   Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  empleado     Empleado   @relation(fields: [empleadoId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([movimientoId, empleadoId])
}

// ---------- Infra ----------

model Job {
  id             String    @id @default(cuid())
  empresaId      String?
  tipo           String // EXTRACCION | ARCA | RECURRENTES | EMAIL_IN | TELEGRAM_IN
  payload        Json
  estado         String    @default("queued") // queued|processing|done|failed
  intentos       Int       @default(0)
  maxIntentos    Int       @default(3)
  proximoIntento DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([estado, proximoIntento])
}

model AuditLog {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String?
  entidad   String
  entidadId String
  accion    String
  antes     Json?
  despues   Json?
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([empresaId, entidad, entidadId])
}

// Telegram chat ↔ empresa link (created via /vincular {code})
model TelegramVinculo {
  id        String   @id @default(cuid())
  empresaId String
  chatId    String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())
}

// Webhook idempotency: email message ids / telegram update ids already processed
model EventoWebhook {
  id           String   @id @default(cuid())
  canal        String // EMAIL | TELEGRAM
  claveExterna String
  createdAt    DateTime @default(now())

  @@unique([canal, claveExterna])
}
