# --- Required ---
DATABASE_URL=postgresql://pnl:pnl@localhost:5433/postgres
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Integrations (all optional; the app runs end-to-end in mock mode) ---
# LLM extraction: mock (default) | real (requires ANTHROPIC_API_KEY)
EXTRACTOR_MODE=mock
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-sonnet-4-6

# ARCA voucher verification: mock (default) | ws (requires certificate)
# Cifrado de la Clave Fiscal guardada por empresa para bajar "Mis Comprobantes"
# del portal de ARCA (32 bytes en hex: `openssl rand -hex 32`). Sin esto no se
# pueden guardar credenciales en Configuración.
ARCA_PORTAL_SECRET=

# Inbound email webhook shared secret (required only to enable the email channel)
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=pnl.example.com

# Telegram bot (empty = channel disabled; webhook still accepts mock payloads)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# File storage: local (default) | s3 (interface ready, not implemented)
FILE_STORAGE=local
FILE_STORAGE_DIR=./storage
