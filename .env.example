# --- Required ---
DATABASE_URL=postgresql://pnl:pnl@localhost:5433/postgres
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Integrations (all optional; the app runs end-to-end in mock mode) ---
# LLM extraction: mock (default) | real (requires ANTHROPIC_API_KEY)
EXTRACTOR_MODE=mock
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-sonnet-4-6
# Prefiltro de no comprobantes: un modelo chico decide antes de gastar la
# extracción (sólo en modo real). PREFILTRO_DOCUMENTOS=off lo apaga.
CLASIFICADOR_MODEL=claude-haiku-4-5-20251001
PREFILTRO_DOCUMENTOS=on

# ARCA voucher verification: mock (default) | ws (requires certificate)
# Cifrado de la Clave Fiscal guardada por empresa para bajar "Mis Comprobantes"
# del portal de ARCA (32 bytes en hex: `openssl rand -hex 32`). Sin esto no se
# pueden guardar credenciales en Configuración.
ARCA_PORTAL_SECRET=

# Inbound email webhook shared secret (required only to enable the email channel)
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=pnl.example.com

# Resend (mails): avisos salientes y facturas entrantes en
# comprobantes+{empresa}@INBOUND_EMAIL_DOMAIN (el worker las consulta cada minuto).
# Sin key, los avisos por mail y la recepción quedan apagados.
RESEND_API_KEY=
EMAIL_REMITENTE="P&L Manager <avisos@ledger.ar>"
# Sólo se procesan mails de casillas de usuarios de la empresa con DMARC = pass.
# EMAIL_EXIGIR_DMARC=off acepta el remitente sin verificarlo (sólo emergencias).
EMAIL_EXIGIR_DMARC=on
# Owner de la aplicación: recibe los avisos de problemas de la app (IA sin crédito…).
# Los errores de carga van a quien cargó; los de una empresa, a sus administradores.
APP_OWNER_EMAIL=
APP_URL=https://pnl.ledger.ar
# Opcional: además del mail, avisar al owner por Telegram (ids de chat, separados por coma)
ALERTAS_TELEGRAM_CHAT_ID=

# Telegram bot (empty = channel disabled; webhook still accepts mock payloads)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# File storage: local (default) | s3 (interface ready, not implemented)
FILE_STORAGE=local
FILE_STORAGE_DIR=./storage
